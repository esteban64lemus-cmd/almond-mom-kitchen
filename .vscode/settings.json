{
    "files.watcherExclude": {
        "**/target": true
    },
    "css.validate": false,
    "tailwindCSS.emmetCompletions": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/CVS": true,
        "**/.ruby-lsp": true
    },
    "python-envs.pythonProjects": [
        {
            "path": "src",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ]
}