# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, or the anon key if that is what the host has.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for newsletter persistence (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Public origin for signup confirmation links (emailRedirectTo).
NEXT_PUBLIC_SITE_URL=https://almondmom.online

# Vercel AI Gateway (routes to OpenAI gpt-4o)
AI_GATEWAY_API_KEY=

# ElevenLabs text-to-speech (server-only — never prefix with NEXT_PUBLIC_)
ELEVENLABS_API_KEY=
# Optional: defaults to the premade "Rachel" voice / eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
